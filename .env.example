# Copy to .env at the repo root and fill in what you use. Environment variables win over this file.

# fal.ai: Seedream (default lane) and Nano Banana. https://fal.ai/dashboard/keys
# FAL_API_KEY is accepted as an alias.
FAL_KEY=

# Google Gemini: Nano Banana called directly, used by --lane nanobanana when FAL_KEY is empty.
# https://aistudio.google.com/apikey  (GOOGLE_API_KEY is accepted as an alias)
GEMINI_API_KEY=

# Optional: path to Chrome/Chromium/Edge if it is not found automatically (lettering, trailer statics).
# KAV_CHROME=/usr/bin/chromium

# Optional: Gemini image model id for the direct lane.
# KAV_GEMINI_MODEL=gemini-3-pro-image-preview

# Optional: repo root, if the tools are run from a copy outside the repo.
# KAV_HOME=/path/to/kav
